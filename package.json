{
  "name": "pagecraft-pdf-editor",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "description": "Free, private, offline-capable PDF editor that runs entirely in the browser.",
  "scripts": {
    "copy-assets": "node scripts/copy-assets.mjs",
    "dev": "npm run copy-assets && vite",
    "build": "npm run copy-assets && tsc -b && vite build",
    "desktop": "npm run build && npm --prefix desktop install && npm --prefix desktop start",
    "desktop:win": "npm run build && npm --prefix desktop install && npm --prefix desktop run dist:win",
    "preview": "vite preview",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans-arabic": "^0.4.3",
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@pdf-lib/standard-fonts": "^1.0.0",
    "@tesseract.js-data/ara": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "lucide-react": "^1.70.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0"
  }
}
