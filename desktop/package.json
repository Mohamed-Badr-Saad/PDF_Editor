{
  "name": "pagecraft",
  "productName": "PageCraft",
  "version": "0.5.0",
  "description": "Free PDF editor that works offline. Edit text and images, sign, OCR, merge and organize PDFs.",
  "author": {
    "name": "Mohamed Badr",
    "url": "https://mohamed-badr-nine.vercel.app/"
  },
  "license": "MIT",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "copy-app": "node copy-app.cjs",
    "start": "npm run copy-app && electron .",
    "dist:win": "npm run copy-app && electron-builder --win --publish never",
    "dist:mac": "npm run copy-app && electron-builder --mac --publish never",
    "dist:linux": "npm run copy-app && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0"
  },
  "repository": "https://github.com/Mohamed-Badr-Saad/PDF_Editor",
  "homepage": "https://mohamed-badr-saad.github.io/PDF_Editor/"
}
